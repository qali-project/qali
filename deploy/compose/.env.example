# Copy to .env and edit. This file contains no secrets: key material lives in
# files under QALI_SECRETS_DIR (see docs/DEVELOPMENT.md, "Deployment").

# Public host name served by the reverse proxy.
QALI_DOMAIN=qali.example.org

# "internal" (self-signed local CA) or an email address for public ACME
# certificates via the TLS-ALPN challenge on port 443.
QALI_TLS=internal

# Directory with database_url, kek, token_pepper, password_pepper, and
# postgres_password files (mode 0600, outside version control).
QALI_SECRETS_DIR=./secrets

# Application image, pinned to a release tag and digest in production.
QALI_IMAGE=qali:dev
