# Allowlist: only what the image build needs. Secrets, .env files, tests,
# and build outputs never enter the build context.
*
!go.mod
!go.sum
!cmd/
!internal/
!migrations/
!web/
web/node_modules/
web/playwright-report/
web/test-results/
web/e2e/
internal/platform/webui/dist/app/
**/*_test.go
**/testdata/
**/.env
**/.env.*
**/*.key
**/*.pem
